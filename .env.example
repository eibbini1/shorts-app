# =============================================================================
# Abdul Across America — Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED: Tell the pipeline to use AbdulImageProvider
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=abdul-flow

# ---------------------------------------------------------------------------
# Generation path: "browser" (free, Nano Banana 2.1) or "api" (paid Imagen3)
# ---------------------------------------------------------------------------
ABDUL_PROVIDER=browser

# ---------------------------------------------------------------------------
# Google Flow project (browser path)
# Your Flow project: https://flow.google.com/project/e29453e7-d786-4fe0-9f75-57a3076f5b91
# ---------------------------------------------------------------------------
FLOW_PROJECT_ID=e29453e7-d786-4fe0-9f75-57a3076f5b91

# ---------------------------------------------------------------------------
# If you have your general Playwright browser bot already running,
# point to its WebSocket endpoint and AbdulImageProvider reuses the session.
# Leave blank to launch a fresh headless Chrome.
# ---------------------------------------------------------------------------
PLAYWRIGHT_WS_ENDPOINT=

# Playwright profile directory — where your Google account cookies live.
# Default: ~/.config/google-chrome (macOS: ~/Library/Application Support/Google/Chrome)
PLAYWRIGHT_USER_DATA_DIR=

# ---------------------------------------------------------------------------
# API path (only needed when ABDUL_PROVIDER=api)
# Get your key: https://console.cloud.google.com/apis/credentials
# Enable: Vertex AI API + Imagen3
# ---------------------------------------------------------------------------
IMAGEN3_API_KEY=

# ---------------------------------------------------------------------------
# Output directories
# ---------------------------------------------------------------------------
ABDUL_OUTPUT_DIR=./storage/visuals/abdul
# STORAGE_ROOT=./storage  (used by the broader pipeline)

# ---------------------------------------------------------------------------
# Episode label injected into every image prompt
# Override per run: ABDUL_EPISODE="New York Ep2" npm run create-abdul -- ...
# ---------------------------------------------------------------------------
ABDUL_EPISODE=Chicago Ep1

# ---------------------------------------------------------------------------
# Optional: music + SFX libraries
# Put .mp3 files in subdirectories named by mood: happy/, curious/, etc.
# Leave blank to use synthesized placeholders (totally fine for now)
# ---------------------------------------------------------------------------
MUSIC_LIBRARY_DIR=
SFX_LIBRARY_DIR=

# ---------------------------------------------------------------------------
# Pipeline safety flags
# ---------------------------------------------------------------------------
# Set to "true" to accept unverified visuals (useful for testing)
ALLOW_UNVERIFIED_VISUALS=true

# ---------------------------------------------------------------------------
# LLM + TTS (needed for generic createShort, not for createAbdulEpisode)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# PEXELS_API_KEY=
