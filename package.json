{
  "name": "ai-shorts-platform",
  "version": "0.1.0",
  "description": "Automated AI YouTube Shorts content factory",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-short": "tsx src/cli/createShort.ts",
    "upload-video": "tsx src/cli/uploadVideo.ts",
    "scheduler": "tsx src/cli/runScheduler.ts",
    "verify-live-run": "tsx src/cli/verifyLiveRun.ts",
    "list-pending": "tsx src/cli/listPending.ts",
    "render-demo": "tsx src/cli/renderDemo.ts",
    "create-abdul": "tsx src/cli/createAbdulEpisode.ts",
    "assemble-abdul": "tsx src/cli/assembleEpisode.ts",
    "split-long": "tsx src/cli/splitLong.ts",
    "meta-gen": "tsx src/cli/metaGen.ts",
    "plan-schedule": "tsx src/cli/planSchedule.ts",
    "yt-upload": "tsx src/cli/ytUpload.ts",
    "export-subs": "tsx src/cli/exportSubs.ts",
    "qa-check": "tsx src/cli/qaCheck.ts",
    "make-thumbs": "tsx src/cli/makeThumbs.ts",
    "variation": "tsx src/cli/variation.ts",
    "pipeline": "tsx src/cli/pipeline.ts",
    "automate": "tsx src/cli/automate.ts",
    "automate:watch": "tsx src/cli/automate.ts --watch",
    "draft-shorts": "tsx src/cli/draftShorts.ts",
    "approve-draft": "tsx src/cli/approveDraft.ts",
    "channel-snapshot": "tsx src/cli/channelSnapshot.ts",
    "setup:mac": "bash scripts/setup-mac.sh",
    "start:comfy:mac": "bash scripts/mac-runtime.sh comfy",
    "test:motion:mac": "bash scripts/mac-runtime.sh motion",
    "doctor:local": "node scripts/local-media.mjs doctor",
    "draft:local": "node scripts/bb-local-scenario.mjs",
    "scenario:export": "node scripts/local-media-export.mjs",
    "scenario:review": "tsx src/cli/reviewScenario.ts",
    "scenario:narrate": "node scripts/narrate-scenario.mjs",
    "make:chocolate:mac": "bash scripts/chocolate-short-local.sh",
    "make:gold-steak:mac": "bash scripts/gold-steak-local.sh",
    "make:crust:mac": "python3 scripts/steak-crust-local.py",
    "make:any:mac": "bash scripts/make-local-video.sh",
    "chocolate:motion:mac": "python3 scripts/chocolate-short/generate-motion.py",
    "models:check:mac": "python3 scripts/models-status-mac.py",
    "trends:local": "python3 scripts/fetch-trends.py",
    "montage:local:mac": "python3 scripts/assemble-motion-video.py",
    "image:local:mac": "python3 scripts/create-local-image.py",
    "image:flux:mac": "python3 scripts/create-flux-image.py",
    "review:shot:local": "python3 scripts/record-shot-review.py"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "dotenv": "^16.4.5",
    "google-auth-library": "^11.3.2",
    "googleapis": "^189.0.0",
    "node-cron": "^4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
