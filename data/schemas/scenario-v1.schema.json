{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts-app.local/schemas/scenario-v1.schema.json",
  "title": "Local Scenario v1",
  "description": "Shared Scenario v1 contract exchanged between the local drafting/rendering scripts and the TypeScript/hosted MotionEngine layer.",
  "type": "object",
  "required": ["settings", "plan"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Optional for legacy pre-v1 scenarios; new scenarios always stamp 1."
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "topic": {
      "type": "string",
      "maxLength": 1000
    },
    "style": {
      "type": "string",
      "maxLength": 500
    },
    "model": {
      "type": "string",
      "maxLength": 120
    },
    "requestedEnding": {
      "type": ["string", "null"],
      "maxLength": 1000
    },
    "totalSeconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 1800
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "plan": {
      "$ref": "#/$defs/plan"
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "required": ["format", "seconds"],
      "additionalProperties": true,
      "properties": {
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "format": {
          "type": "string",
          "enum": ["short", "long", "wide", "vertical"]
        },
        "seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1800
        },
        "presentationMode": {
          "type": "string",
          "enum": ["auto", "asmr", "voiced"]
        },
        "look": {
          "type": "string",
          "enum": ["food", "cartoon", "night", "custom"]
        },
        "quality": {
          "type": "string",
          "enum": ["standard", "high"]
        },
        "voice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "idea": {
      "type": "object",
      "required": ["title", "angle"],
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "angle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "sceneState": {
      "type": "object",
      "required": ["before", "action", "after"],
      "additionalProperties": true,
      "properties": {
        "before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "visualChecks": {
      "type": "object",
      "required": ["mustShow", "mustNotShow", "questions"],
      "additionalProperties": true,
      "properties": {
        "mustShow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "mustNotShow": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "shot": {
      "type": "object",
      "required": ["seconds", "narration", "imagePrompt", "motionPrompt", "sound"],
      "additionalProperties": true,
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "narration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "imagePrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "motionPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sound": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "voiceLeadSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "sceneState": {
          "$ref": "#/$defs/sceneState"
        },
        "visualChecks": {
          "$ref": "#/$defs/visualChecks"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": ["title", "hook", "payoff", "shots", "claimsToCheck"],
      "additionalProperties": true,
      "properties": {
        "ideas": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/idea"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "payoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 900,
          "items": {
            "$ref": "#/$defs/shot"
          }
        },
        "claimsToCheck": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
